{
  "expo": {
    "name": "dev-chat",
    "slug": "dev-chat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#075E54"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.devchat.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#075E54"
      },
      "package": "com.devchat.app",
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE", "READ_MEDIA_IMAGES"],
      "softwareKeyboardLayoutMode": "pan"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "La app necesita acceder a tus fotos para tu avatar de perfil",
          "cameraPermission": "La app necesita acceder a la cámara para tu avatar"
        }
      ]
    ]
  }
}
